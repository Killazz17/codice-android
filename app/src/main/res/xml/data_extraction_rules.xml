<?xml version="1.0" encoding="utf-8"?>
<!--
   Ni el respaldo en la nube ni la transferencia a otro teléfono llevan datos de la app: la sesión (JWT) y la caché
   local se vuelven a pedir iniciando sesión. Ver también backup_rules.xml (API 30 o menos).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
