<?xml version="1.0" encoding="utf-8"?>
    <manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        Sin este permiso, AuthRepositoryImpl/NoteRepositoryImpl (Retrofit
        contra Mockoon, ver NetworkModule.kt) fallan con
        DomainError.Network en cada llamada: Android bloquea cualquier
        socket saliente si la app no lo declara, sin importar que el
        emulador tenga internet.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        android:name apunta a la clase Application de Hilt. Sin esta linea, la
        anotacion @HiltAndroidApp no tiene efecto y la inyeccion falla en
        tiempo de ejecucion.
    -->
    <application
        android:name=".CodiceApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SierraAppMobile">

        <!--
            exported="true" es obligatorio para la Activity de arranque: le dice
            a Android que el lanzador del sistema puede abrirla.
            El intent-filter con MAIN + LAUNCHER es lo que hace que aparezca el
            icono de la app en el menu del telefono.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SierraAppMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>